{
  "expo": {
    "name": "RollCal",
    "slug": "rollcal",
    "scheme": "rollcal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F4EE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rollcal",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:rollcal.app"
      ]
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1F5C4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "app.rollcal",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAUQLgVNsIcqyKtK786U_cj7dGDaX-2-W0"
        }
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rollcal.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "rollcal.app",
              "pathPrefix": "/event"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F6F4EE",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#111513"
          },
          "imageWidth": 120
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RollCal to access your location to set event locations.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RollCal to use your camera to scan event QR codes and receipts.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RollCal to access your photos to upload event photos and profile pictures."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow RollCal to access your photos to upload event photos and profile pictures.",
          "savePhotosPermission": "Allow RollCal to save event photos to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-video",
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "108bc5b1-c875-4814-9d08-bafec67b2f3e"
      }
    },
    "owner": "abdullah.elg"
  }
}
