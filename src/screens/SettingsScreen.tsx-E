// The Settings tab: profile, theme, default currency, reminder and
// notification toggles, quiet mode, payment methods, support, legal
// pages, sign out and account deletion. Deletion calls the delete-account
// edge function.

import { useFocusEffect } from '@react-navigation/native';
import { useCallback, useEffect, useMemo, useState } from 'react';
import {
  ActivityIndicator,
  Alert,
  AppState,
  Modal,
  Platform,
  Pressable,
  ScrollView,
  StatusBar as RNStatusBar,
  StyleSheet,
  Text,
  View,
} from 'react-native';
import { SafeAreaView, useSafeAreaInsets } from 'react-native-safe-area-context';
import ConfirmDialog from '../components/ConfirmDialog';
import CurrencyPicker from '../components/CurrencyPicker';
import { ChevronRightIcon } from '../components/icons';
import { Button, ErrorText, SECTION_GAP, SectionLabel, ThemedSwitch } from '../components/ui';
import { useAuth } from '../context/AuthContext';
import { useTheme } from '../context/ThemeContext';
import { PLAN_NAMES, planOf } from '../lib/pro';
import EditableAvatar from '../components/EditableAvatar';
import { currencyLabel } from '../lib/currency';
import { supabase } from '../lib/supabase';
import { hapticLight } from '../lib/haptics';
import {
  ALBUM_PREF_KEYS,
  CHAT_PREF_KEYS,
  notificationsAllowed,
  EVENT_PREF_KEYS,
  FRIEND_PREF_KEYS,
  getReminderPrefs,
  notificationsAvailable,
  ReminderPrefs,
  setReminderPrefs,
  turnOnNotifications,
  syncEventReminders,
} from '../lib/notifications';
import { setQuietMode } from '../lib/safety';
import { listPaymentMethods } from '../lib/paymentMethods';
import { NativeStackScreenProps } from '@react-navigation/native-stack';
import { AppStackParamList } from '../navigation/types';
import {
  fonts,
  Palette,
  radii,
  spacing,
  TypeTokens,
} from '../theme';
import InfoTip from '../components/InfoTip';

type Props = NativeStackScreenProps<AppStackParamList, 'Settings'>;

type RowProps = {
  label: string;
  caption?: string;
  value: boolean;
  onToggle: (next: boolean) => void;
  // A short explanation behind an ⓘ next to the label.
  info?: string;
};

type ToggleRow = { key: keyof ReminderPrefs; label: string; caption?: string };

// Each sheet's toggles, in the order they fire.
const EVENT_ROWS: ToggleRow[] = [
  { key: 'dayBefore', label: '1 day before' },
  { key: 'hourBefore', label: '1 hour before' },
  { key: 'thirtyMin', label: '30 minutes before' },
  { key: 'fiveMin', label: '5 minutes before' },
  { key: 'atStart', label: 'When the event starts' },
];

const ALBUM_ROWS: ToggleRow[] = [
  {
    key: 'albumOpen',
    label: 'When photos open',
    caption: 'When the event starts and photo uploads begin',
  },
  { key: 'albumDayLeft', label: '1 day till it closes' },
  { key: 'albumHourLeft', label: '1 hour till it closes' },
  { key: 'albumClosed', label: 'When it closes' },
  {
    key: 'photosExpiring',
    label: 'Before photos are deleted',
    caption: 'A week and a day before a free event’s photos are deleted',
  },
];

const FRIEND_ROWS: ToggleRow[] = [
  {
    key: 'friendRequest',
    label: 'New friend requests',
    caption: 'When someone adds you',
  },
  { key: 'friendAccepted', label: 'Requests accepted' },
  {
    key: 'eventInvite',
    label: 'Event invitations',
    caption: 'When a friend invites you to an event',
  },
  {
    key: 'billShared',
    label: 'Bills',
    caption: 'New bills, payments sent and received, and reminders',
  },
];

const CHAT_ROWS: ToggleRow[] = [
  {
    key: 'chatMessage',
    label: 'New messages',
    caption: "From events you're part of",
  },
];

const QUIET_CAPTION =
  'Friend requests to you are hidden. You can still add anyone, and adding someone who already asked you makes you friends.';

// Defined out here on purpose. Declared inside the screen, it would be a
// brand-new component type on every render, so toggling one switch would
// unmount and remount every other row - replaying their switch animations.
function SettingRow({ label, caption, value, onToggle, info }: RowProps) {
  const { type } = useTheme();
  return (
    <View style={rowStyles.row}>
      <View style={rowStyles.text}>
        <View style={rowStyles.labelRow}>
          <Text style={type.body}>{label}</Text>
          {info ? <InfoTip title={label} text={info} /> : null}
        </View>
        {caption ? <Text style={type.caption}>{caption}</Text> : null}
      </View>
      <ThemedSwitch value={value} onValueChange={onToggle} />
    </View>
  );
}

const rowStyles = StyleSheet.create({
  row: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
    gap: spacing.md,
  },
  text: {
    flex: 1,
    gap: 2,
  },
  labelRow: { flexDirection: 'row', alignItems: 'center', gap: spacing.sm },
});

export default function SettingsScreen({ navigation }: Props) {
  const { session, profile, signOut, refreshProfile } = useAuth();
  const { mode, preference, setPreference, colors, type } = useTheme();
  const styles = useMemo(() => makeStyles(colors, type), [colors, type]);
  const [prefs, setPrefsState] = useState<ReminderPrefs | null>(null);
  const [permissionDenied, setPermissionDenied] = useState(false);
  const [confirmLogout, setConfirmLogout] = useState(false);
  const [confirmDelete, setConfirmDelete] = useState(false);
  const [deleting, setDeleting] = useState(false);
  const [paymentCount, setPaymentCount] = useState(0);
  const [quietError, setQuietError] = useState<string | null>(null);
  const [pickingCurrency, setPickingCurrency] = useState(false);
  const [currencyError, setCurrencyError] = useState<string | null>(null);

  // New bills use it; bills already shared keep their own currency.
  const chooseCurrency = async (code: string) => {
    setPickingCurrency(false);
    if (!profile || code === profile.currency) return;
    setCurrencyError(null);
    const { error } = await supabase.from('profiles').update({ currency: code }).eq('id', profile.id);
    if (error) setCurrencyError('Could not change your currency. Please try again.');
    else await refreshProfile();
  };
  const [openSheet, setOpenSheet] = useState<
    'event' | 'album' | 'friend' | 'chat' | null
  >(null);

  // The switch moves the moment it's tapped, like the other toggles, and
  // goes back only if saving fails. Waiting for the save made it slide over,
  // snap back and slide again on Android.
  const [quietOn, setQuietOn] = useState(!!profile?.quiet_mode);
  useEffect(() => {
    setQuietOn(!!profile?.quiet_mode);
  }, [profile?.quiet_mode]);

  const toggleQuiet = async (next: boolean) => {
    if (!profile) return;
    setQuietError(null);
    setQuietOn(next);
    const err = await setQuietMode(profile.id, next);
    if (err) {
      setQuietOn(!next);
      setQuietError(err);
    } else await refreshProfile();
  };

  // Profile photo for everyone, or friends only (avatar-visibility.sql; the
  // database decides who gets the photo's link).
  const [photoPublic, setPhotoPublic] = useState(!!profile?.avatar_public);
  const [photoError, setPhotoError] = useState<string | null>(null);
  useEffect(() => {
    setPhotoPublic(!!profile?.avatar_public);
  }, [profile?.avatar_public]);

  const togglePhotoPublic = async (next: boolean) => {
    if (!profile) return;
    setPhotoError(null);
    setPhotoPublic(next);
    const { error } = await supabase.from('profiles').update({ avatar_public: next }).eq('id', profile.id);
    if (error) {
      setPhotoPublic(!next);
      setPhotoError('Couldn’t change that. Try again.');
    } else await refreshProfile();
  };

  // Server side lives in supabase/functions/delete-account: it removes the
  // user's files, then the auth user, which cascades to every row of theirs.
  const handleDeleteAccount = async () => {
    setConfirmDelete(false);
    setDeleting(true);
    const { error } = await supabase.functions.invoke('delete-account', {
      method: 'POST',
    });
    if (error) {
      setDeleting(false);
      Alert.alert('Delete account', 'Could not delete your account. Please try again.');
      return;
    }
    await signOut();
  };

  useEffect(() => {
    getReminderPrefs().then(setPrefsState);
  }, []);

  const userId = session?.user.id;
  useFocusEffect(
    useCallback(() => {
      if (!userId) return;
      listPaymentMethods(userId).then((res) => setPaymentCount(res.methods.length));
    }, [userId])
  );

  // Whether the phone allows RollCal's notifications. Checked again whenever
  // the app comes back, since people turn them on in the phone's settings.
  const [osAllowed, setOsAllowed] = useState<boolean | null>(null);
  useEffect(() => {
    const check = () =>
      notificationsAllowed().then((allowed) => {
        setOsAllowed(allowed);
        if (allowed) setPermissionDenied(false);
      });
    check();
    const sub = AppState.addEventListener('change', (state) => {
      if (state === 'active') check();
    });
    return () => sub.remove();
  }, []);

  // The "Allow notifications" prompt, or the phone's settings when it won't
  // show it any more.
  const enableNotifications = async () => {
    const result = await turnOnNotifications(userId);
    if (result === 'allowed') {
      setOsAllowed(true);
      setPermissionDenied(false);
    } else if (result === 'settings' || result === 'denied') {
      setPermissionDenied(true);
    }
  };

  const toggleReminder = async (key: keyof ReminderPrefs, next: boolean) => {
    if (!prefs) return;
    // Where notifications can't run at all (Expo Go on Android), still save
    // the choice - it takes effect in a development build.
    if (next && notificationsAvailable && osAllowed !== true) {
      const result = await turnOnNotifications(userId);
      if (result !== 'allowed') {
        setPermissionDenied(result === 'settings' || result === 'denied');
        return;
      }
      setOsAllowed(true);
      setPermissionDenied(false);
    }
    const updated = { ...prefs, [key]: next };
    setPrefsState(updated);
    await setReminderPrefs(updated);
    // Recompute the device's scheduled reminders with the new prefs.
    syncEventReminders();
  };

  // "2 on" style summary for the collapsed rows.
  const countOn = (keys: (keyof ReminderPrefs)[]) =>
    prefs ? keys.filter((k) => prefs[k]).length : 0;

  const sheetRows =
    openSheet === 'album'
      ? ALBUM_ROWS
      : openSheet === 'friend'
        ? FRIEND_ROWS
        : openSheet === 'chat'
          ? CHAT_ROWS
          : EVENT_ROWS;

  const insets = useSafeAreaInsets();
  // No tab bar here (it's a pushed screen): just clear the home indicator.
  const bottomInset = insets.bottom;

  const handleSelectPreference = (opt: 'system' | 'light' | 'dark') => {
    hapticLight();
    setPreference(opt);
  };

  return (
    // Opened from the Profile tab's gear; the stack draws the title and back button.
    <SafeAreaView style={styles.screen} edges={[]}>
      <ScrollView
        style={styles.screen}
        contentContainerStyle={[
          styles.content,
          { paddingBottom: bottomInset + spacing.xxl },
        ]}
      >
        {/* You, first, like the phone's own Settings. The Profile tab has the same. */}
        <View style={styles.card}>
          <View style={styles.profileHeaderRow}>
            <EditableAvatar size={64} backdrop={colors.card} />
            <View style={styles.profileInfoCol}>
              <Text style={styles.profileDisplayName} numberOfLines={1}>
                {profile?.display_name}
              </Text>
              {profile?.username ? (
                <Text style={styles.profileUsername} numberOfLines={1}>
                  @{profile.username}
                </Text>
              ) : null}
            </View>
          </View>
          <Button
            title="Edit profile"
            variant="secondary"
            onPress={() => navigation.navigate('EditProfile')}
            style={styles.editProfile}
          />
          <View style={styles.rowDivider} />
          <Pressable
            style={({ pressed }) => [styles.linkRow, pressed && { opacity: 0.6 }]}
            onPress={() => navigation.navigate('Upgrade', { reason: 'settings' })}
            accessibilityRole="button"
          >
            <View style={styles.rowText}>
              <Text style={type.body}>Plan</Text>
              <Text style={type.caption}>{PLAN_NAMES[planOf(profile)]}</Text>
            </View>
            <ChevronRightIcon size={16} color={colors.inkMuted} />
          </Pressable>
        </View>

        <SectionLabel style={styles.sectionGap}>Appearance</SectionLabel>
        <View style={styles.card}>
          <Text style={type.body}>Theme</Text>
          <Text style={[type.caption, { marginTop: 2, marginBottom: spacing.md }]}>
            {preference === 'system'
              ? `Following phone settings (${mode === 'dark' ? 'Dark' : 'Light'})`
              : preference === 'dark'
                ? 'Dark mode active'
                : 'Light mode active'}
          </Text>
          <View style={styles.themeToggle}>
            {(['system', 'light', 'dark'] as const).map((opt) => (
              <Pressable
                key={opt}
                onPress={() => handleSelectPreference(opt)}
                style={[
                  styles.themeToggleOption,
                  preference === opt && styles.themeToggleActive,
                ]}
              >
                <Text
                  style={[
                    styles.themeToggleText,
                    preference === opt && { color: colors.onAccent },
                  ]}
                >
                  {opt === 'system' ? 'System' : opt === 'light' ? 'Light' : 'Dark'}
                </Text>
              </Pressable>
            ))}
          </View>
        </View>

        <View style={[styles.sectionLabelRow]}>
          <SectionLabel style={{ marginBottom: 0 }}>Notifications</SectionLabel>
          <InfoTip title="Notifications" text="Reminders are scheduled on this phone for events you're part of. Pushes for messages and friend requests come from RollCal." />
        </View>
        <View style={styles.card}>
          {osAllowed === false && (
            <>
              <View style={styles.notifOffRow}>
                <View style={styles.rowText}>
                  <Text style={type.body}>Notifications are off</Text>
                  <Text style={type.caption}>
                    Turn them on to hear about invites, messages and when you can add photos.
                  </Text>
                </View>
                <Button title="Turn on" variant="secondary" onPress={enableNotifications} style={styles.notifOffButton} />
              </View>
              <View style={styles.rowDivider} />
            </>
          )}
          <Pressable
            style={({ pressed }) => [styles.linkRow, pressed && { opacity: 0.6 }]}
            onPress={() => setOpenSheet('event')}
          >
            <View style={styles.rowText}>
              <Text style={type.body}>Event reminders</Text>
              <Text style={type.caption}>
                {countOn([...EVENT_PREF_KEYS])} of {EVENT_PREF_KEYS.length} on
              </Text>
            </View>
            <ChevronRightIcon size={16} color={colors.inkMuted} />
          </Pressable>
          <View style={styles.rowDivider} />
          <Pressable
            style={({ pressed }) => [styles.linkRow, pressed && { opacity: 0.6 }]}
            onPress={() => setOpenSheet('album')}
          >
            <View style={styles.rowText}>
              <Text style={type.body}>Photo reminders</Text>
              <Text style={type.caption}>
                {countOn([...ALBUM_PREF_KEYS])} of {ALBUM_PREF_KEYS.length} on
              </Text>
            </View>
            <ChevronRightIcon size={16} color={colors.inkMuted} />
          </Pressable>
          <View style={styles.rowDivider} />
          <Pressable
            style={({ pressed }) => [styles.linkRow, pressed && { opacity: 0.6 }]}
            onPress={() => setOpenSheet('friend')}
          >
            <View style={styles.rowText}>
              <Text style={type.body}>Friends</Text>
              <Text style={type.caption}>
                {countOn([...FRIEND_PREF_KEYS])} of {FRIEND_PREF_KEYS.length} on
              </Text>
            </View>
            <ChevronRightIcon size={16} color={colors.inkMuted} />
          </Pressable>
          <View style={styles.rowDivider} />
          <Pressable
            style={({ pressed }) => [styles.linkRow, pressed && { opacity: 0.6 }]}
            onPress={() => setOpenSheet('chat')}>
            <View style={styles.rowText}>
              <Text style={type.body}>Chat</Text>
              <Text style={type.caption}>
                {countOn([...CHAT_PREF_KEYS])} of {CHAT_PREF_KEYS.length} on
              </Text>
            </View>
            <ChevronRightIcon size={16} color={colors.inkMuted} />
          </Pressable>
        </View>
      {permissionDenied && (
        <Text style={styles.permissionHint}>
          Allow notifications for RollCal in your phone's settings, then come
          back here.
        </Text>
      )}
      {!notificationsAvailable && (
        <Text style={[type.caption, { marginTop: spacing.sm }]}>
          Expo Go on Android can't deliver notifications. Your choices are saved and will start working in a development build.
        </Text>
      )}

      <SectionLabel style={styles.sectionGap}>Payments</SectionLabel>
      <View style={styles.card}>
        <Pressable
          style={({ pressed }) => [styles.linkRow, pressed && { opacity: 0.6 }]}
          onPress={() => navigation.navigate('PaymentMethods')}
        >
          <View style={styles.rowText}>
            <Text style={type.body}>Receiving methods</Text>
            <Text style={type.caption}>
              {paymentCount > 0
                ? `${paymentCount} saved`
                : 'Add where friends can pay you back'}
            </Text>
          </View>
          <ChevronRightIcon size={16} color={colors.inkMuted} />
        </Pressable>
        <View style={styles.rowDivider} />
        <Pressable
          style={({ pressed }) => [styles.linkRow, pressed && { opacity: 0.6 }]}
          onPress={() => setPickingCurrency(true)}
          accessibilityRole="button"
        >
          <View style={styles.rowText}>
            <Text style={type.body}>Currency</Text>
            <Text style={type.caption}>
              {profile?.currency ? currencyLabel(profile.currency) : 'Not chosen yet'}
            </Text>
          </View>
          <ChevronRightIcon size={16} color={colors.inkMuted} />
        </Pressable>
        <ErrorText message={currencyError} />
      </View>

      <SectionLabel style={styles.sectionGap}>Privacy</SectionLabel>
      <View style={styles.card}>
        <SettingRow
          label="Quiet mode"
          info={QUIET_CAPTION}
          value={quietOn}
          onToggle={toggleQuiet}
        />
        {quietError && (
          <Text style={[type.caption, { color: colors.danger, marginTop: spacing.sm }]}>
            {quietError}
          </Text>
        )}
        <View style={styles.rowDivider} />
        <SettingRow
          label="Show my photo to everyone"
          caption={photoPublic ? 'Everyone' : 'Friends only'}
          info="Off: only your friends see your profile photo; everyone else sees your initials. On: anyone on RollCal can see it."
          value={photoPublic}
          onToggle={togglePhotoPublic}
        />
        {photoError && (
          <Text style={[type.caption, { color: colors.danger, marginTop: spacing.sm }]}>
            {photoError}
          </Text>
        )}
        <View style={styles.rowDivider} />
        <Pressable
          style={({ pressed }) => [styles.linkRow, pressed && { opacity: 0.6 }]}
          onPress={() => navigation.navigate('BlockedPeople')}
          accessibilityRole="button"
        >
          <View style={styles.rowText}>
            <Text style={type.body}>Blocked people</Text>
          </View>
          <ChevronRightIcon size={16} color={colors.inkMuted} />
        </Pressable>
      </View>

      <SectionLabel style={styles.sectionGap}>About</SectionLabel>
      <View style={styles.card}>
        <Pressable
          accessibilityRole="button"
          style={({ pressed }) => [styles.linkRow, pressed && { opacity: 0.6 }]}
          onPress={() => navigation.navigate('Support')}
        >
          <View style={styles.rowText}>
            <Text style={type.body}>Support</Text>
            <Text style={type.caption}>Ask for help or report a problem</Text>
          </View>
          <ChevronRightIcon size={16} color={colors.inkMuted} />
        </Pressable>
        <View style={styles.rowDivider} />
        {(
          [
            { doc: 'terms', label: 'Terms of Service' },
            { doc: 'pro', label: 'Pro Terms' },
            { doc: 'privacy', label: 'Privacy Policy' },
          ] as const
        ).map(({ doc, label }, i) => (
          <View key={doc}>
            {i > 0 && <View style={styles.rowDivider} />}
            <Pressable
              accessibilityRole="button"
              style={({ pressed }) => [styles.linkRow, pressed && { opacity: 0.6 }]}
              onPress={() => navigation.navigate('Legal', { doc })}
            >
              <Text style={[type.body, styles.rowText]}>{label}</Text>
              <ChevronRightIcon size={16} color={colors.inkMuted} />
            </Pressable>
          </View>
        ))}
        <View style={styles.rowDivider} />
        <Pressable
          accessibilityRole="button"
          style={({ pressed }) => [styles.linkRow, pressed && { opacity: 0.6 }]}
          onPress={() => navigation.navigate('Licenses')}
        >
          <Text style={[type.body, styles.rowText]}>Open-source licences</Text>
          <ChevronRightIcon size={16} color={colors.inkMuted} />
        </Pressable>
      </View>

      {/* Signing in: log out and delete account, last, below About. */}
      <SectionLabel style={styles.sectionGap}>Signing in</SectionLabel>
      <View style={styles.card}>
        {session?.user.email ? (
          <Text style={[type.caption, styles.signedInAs]} numberOfLines={1}>
            Signed in as {session.user.email}
          </Text>
        ) : null}
        <Button
          title="Log out"
          variant="secondary"
          onPress={() => setConfirmLogout(true)}
          textStyle={{ color: colors.danger }}
        />

        {/* Plain text rather than a button, so it's clearly the rarer action. */}
        <View style={styles.deleteSection}>
          <Pressable
            accessibilityRole="button"
            disabled={deleting}
            onPress={() => setConfirmDelete(true)}
            hitSlop={8}
            style={({ pressed }) => [styles.deleteBtn, pressed && { opacity: 0.7 }]}
          >
            {deleting ? (
              <ActivityIndicator size="small" color={colors.danger} />
            ) : (
              <Text style={styles.deleteText}>Delete account</Text>
            )}
          </Pressable>
        </View>
      </View>

      {/* Reminder toggles live in their own slide-up sheet, one per group. */}
      <CurrencyPicker
        visible={pickingCurrency}
        selected={profile?.currency ?? null}
        intro="New bills you split and plan prices are shown in it. Bills already shared stay in their own currency."
        onSelect={chooseCurrency}
        onClose={() => setPickingCurrency(false)}
      />

      <Modal
        visible={openSheet !== null}
        // iOS: a native sheet, which dims the screen itself. Android: the
        // sheet sits on a see-through layer with the scrim, so it fades in
        // place; sliding would carry the scrim up with it.
        animationType={Platform.OS === 'ios' ? 'slide' : 'fade'}
        presentationStyle={Platform.OS === 'ios' ? 'pageSheet' : 'overFullScreen'}
        transparent={Platform.OS === 'android'}
        statusBarTranslucent={Platform.OS === 'android'}
        onRequestClose={() => setOpenSheet(null)}
      >
        <View style={Platform.OS === 'android' ? styles.sheetOverlay : { flex: 1 }}>
          <SafeAreaView
            style={[
              styles.screen,
              Platform.OS === 'android' && styles.androidSheetCard,
            ]}
            edges={['bottom']}
          >
            {Platform.OS === 'android' && (
              <View style={styles.sheetHandleBar}>
                <View style={styles.sheetHandle} />
              </View>
            )}
            <View style={styles.sheetHeader}>
              <Text style={type.h2}>
                {openSheet === 'album'
                  ? 'Photo reminders'
                  : openSheet === 'friend'
                    ? 'Friend notifications'
                    : openSheet === 'chat'
                      ? 'Chat notifications'
                      : 'Event reminders'}
              </Text>
              <Pressable onPress={() => setOpenSheet(null)} hitSlop={8}>
                <Text style={styles.sheetDone}>Done</Text>
              </Pressable>
            </View>
          <ScrollView contentContainerStyle={styles.content}>
            <Text style={[type.bodyMuted, { marginBottom: spacing.md }]}>
              {openSheet === 'album'
                ? 'Nudges while everyone can still add photos (until 2 days after an event).'
                : openSheet === 'friend'
                  ? 'When people add you, accept your request or invite you to something.'
                  : openSheet === 'chat'
                    ? 'A single event can be muted on its own. Open its chat and tap the bell.'
                    : 'Nudges in the run-up to an event you’re part of.'}
            </Text>
            <View style={styles.card}>
              {prefs &&
                sheetRows.map((row, i) => (
                  <View key={row.key}>
                    {i > 0 && <View style={styles.rowDivider} />}
                    <SettingRow
                      label={row.label}
                      caption={row.caption}
                      value={prefs[row.key]}
                      onToggle={(v) => toggleReminder(row.key, v)}
                    />
                  </View>
                ))}
            </View>
            {permissionDenied && (
              <Text style={styles.permissionHint}>
                Allow notifications for RollCal in your phone's settings, then
                come back here.
              </Text>
            )}
          </ScrollView>
        </SafeAreaView>
      </View>
    </Modal>

      <ConfirmDialog
        visible={confirmLogout}
        title="Log out?"
        message="Your events and albums will be right here when you come back."
        confirmLabel="Log out"
        cancelLabel="Stay"
        destructive
        onConfirm={() => {
          setConfirmLogout(false);
          signOut();
        }}
        onCancel={() => setConfirmLogout(false)}
      />
      <ConfirmDialog
        visible={confirmDelete}
        title="Delete your account?"
        message="This permanently deletes your profile, friends, RSVPs, messages and photos, plus every event you created and its photos. This can't be undone."
        confirmLabel="Delete forever"
        cancelLabel="Keep account"
        destructive
        onConfirm={handleDeleteAccount}
        onCancel={() => setConfirmDelete(false)}
      />
    </ScrollView>
  </SafeAreaView>
  );
}

