# Copy this file to .env and fill in your Supabase project's values.
# Found in Supabase dashboard -> Project Settings -> API.
# The EXPO_PUBLIC_ prefix makes Expo expose these to the app at build time.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: crash reports through Sentry (see src/lib/crashReporting.ts).
# From sentry.io -> your project -> Settings -> Client Keys (DSN). Leave empty to keep it off.
EXPO_PUBLIC_SENTRY_DSN=
