# Apple and Google read these to let rollcal.app links open the app.
/.well-known/apple-app-site-association
  Content-Type: application/json
/.well-known/assetlinks.json
  Content-Type: application/json

# The join page: scripts only from this site (supabase-js is in /vendor),
# talking only to RollCal's database and media server. If Turnstile is ever
# switched on, add https://challenges.cloudflare.com to script-src and frame-src.
/join/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self' https://api.rollcal.app wss://api.rollcal.app https://media.rollcal.app; img-src 'self' data: blob: https://media.rollcal.app https://api.rollcal.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
